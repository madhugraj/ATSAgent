# Environment template — copy to .env.local (gitignored) and fill in.
# Never put secret values in .env: that file IS committed and must stay public-only.
#
# Full deployment matrix with generation commands: DEPLOYMENT-GCP.md §4.

# --- Required: the app will not boot without these ---
DATABASE_URL=postgres://user:pass@host:5432/atsiq
SESSION_SECRET=            # openssl rand -base64 32
PUBLIC_SITE_URL=https://atsiq.yavar.ai

# --- Legacy Supabase variables (UNUSED — do not set) -------------------------
# Authentication is first-party (cookie sessions); the supabase-js client was
# removed in the self-hosting cut. These exist only so old checkouts do not
# break: nothing reads them anymore.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Required for credential encryption at rest (AI keys, OAuth tokens, capture key) ---
SECRET_ENCRYPTION_KEY=     # openssl rand -base64 32

# --- Rate limiter: number of trusted reverse-proxy hops (GKE L7 LB = 1) ---
TRUSTED_PROXY_COUNT=1

# --- AI providers (at least one for AI features; the app boots without them) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=              # optional: raises GitHub API rate limit for social scoring

# --- LinkedIn one-time org connect (feature stays dark without these) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://atsiq.yavar.ai/api/public/linkedin/callback
LINKEDIN_SCOPES=
LINKEDIN_STATE_SECRET=     # openssl rand -base64 32 — REQUIRED when the above are set

# --- Meeting-provider delegated OAuth (Google/Microsoft/Zoom) ---
OAUTH_STATE_SECRET=        # openssl rand -base64 32 — REQUIRED when any of these is configured
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# --- Google sign-in button (optional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Careers-inbox webhook receiver ---
INBOUND_EMAIL_SECRET=      # openssl rand -base64 32
INBOUND_EMAIL_DOMAIN=

# --- Scheduler/cron routes (timing-safe bearer; optional previous secret for rotation) ---
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# --- Transactional email ---
SMTP_URL=                  # e.g. smtps://user:pass@smtp.example.com:465
EMAIL_FROM=

# --- CV vault (S3-compatible; MinIO in local compose; local .local-storage fallback otherwise) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Hardening allowlists (optional) ---
# Chrome extension ids allowed to call the capture endpoint (comma-separated)
CAPTURE_EXTENSION_IDS=
# Extra approved job-board API hosts for integration base URLs (comma-separated)
INTEGRATION_ALLOWED_HOSTS=

# --- Logging (structured JSON lines; debug | info | warn | error) ---
LOG_LEVEL=info
