{
  "displayName": "ATSIQ — server-function availability: fast burn (page)",
  "documentation": {
    "content": "Server-function 5xx ratio is burning the 30-day 99 % availability budget at ≥ 14.4× over both 1 h and 5 min (2 % of the month's budget in an hour). Open Platform → Service health, then Logs Explorer: jsonPayload.msg=\"http.request\" AND jsonPayload.status_class=\"5xx\" and follow trace_id. Targets: src/server/slo.ts.",
    "mimeType": "text/markdown"
  },
  "severity": "CRITICAL",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "5xx ratio > 14.4 × 1 % over 1 h and 5 min",
      "conditionPrometheusQueryLanguage": {
        "query": "(sum(rate(logging_googleapis_com:user_atsiq_http_requests{route_group=\"server_fn\",status_class=\"5xx\"}[1h])) / sum(rate(logging_googleapis_com:user_atsiq_http_requests{route_group=\"server_fn\"}[1h])) > 0.144) and (sum(rate(logging_googleapis_com:user_atsiq_http_requests{route_group=\"server_fn\",status_class=\"5xx\"}[5m])) / sum(rate(logging_googleapis_com:user_atsiq_http_requests{route_group=\"server_fn\"}[5m])) > 0.144)",
        "duration": "120s",
        "evaluationInterval": "60s"
      }
    }
  ],
  "alertStrategy": { "autoClose": "3600s" }
}
