# =============================================================================
# ATSIQ — production environment template (GCP Cloud Run)
# =============================================================================
# HOW TO USE
#   1. Copy this file, fill in the values, and keep it OUT of git.
#   2. Recommended: put each value in Google Secret Manager and let Cloud Run
#      mount them (names + commands in infra/DEPLOYMENT-HANDOFF.md §2), or set
#      them as plain env vars on the service — both work.
#   3. Only DATABASE_URL and SESSION_SECRET are strictly required to boot.
#      SMTP_URL is required for sign-up/invitation/reset emails to be delivered.
#      Everything else unlocks optional features.
#   4. NEVER commit a filled-in .env to the repository.
# =============================================================================

# ---- Required: the app will not boot without these --------------------------
# Cloud SQL connection string. Recommended (unix socket via the Cloud SQL
# connector — the service needs --add-cloudsql-instances + Cloud SQL Client role):
#   postgres://atsiq:<password>@/atsiq?host=/cloudsql/PROJECT:REGION:atsiq
DATABASE_URL=

# Session cookie secret. Generate: openssl rand -hex 32
# Must be >= 32 chars. Changing it signs out every user.
SESSION_SECRET=

# ---- Required: credential encryption at rest -------------------------------
# Encrypts organisation AI/integration credentials stored in the database.
# Generate: openssl rand -base64 32
# BACK THIS UP: rotating it (or losing it) invalidates every stored credential.
SECRET_ENCRYPTION_KEY=

# ---- Public origin ----------------------------------------------------------
# Used in emails, capture links and OAuth redirects. Must match the final domain.
PUBLIC_SITE_URL=https://atsiq.yavar.ai

# ---- Transactional email (required for sign-up / invites / password reset) --
# Example: smtps://user:pass@smtp.yavar.ai:465
SMTP_URL=
# Display address, e.g. ATSIQ <noreply@yavar.ai>
EMAIL_FROM=

# ---- CV vault: S3-compatible object storage ---------------------------------
# Recommended: GCS bucket with HMAC keys (endpoint https://storage.googleapis.com)
# or any MinIO/S3. Without these the app falls back to local disk (fine for dev,
# NOT acceptable for production — files would not survive instance replacement).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Networking / security --------------------------------------------------
# Number of trusted reverse-proxy hops in front of the app (Cloudflare -> LB ->
# Cloud Run counts as the hops that set X-Forwarded-For). 1 is correct for the
# planned topology. The service must not be reachable except through the proxy.
TRUSTED_PROXY_COUNT=1

# ---- Scheduled jobs (careers-inbox scoring, candidate re-scoring) -----------
# Bearer token expected by /api/public/inbox-sync and /api/public/sync-candidates.
# Generate: openssl rand -hex 32 — Cloud Scheduler sends it as Authorization header.
CRON_SECRET=
# Optional: set the OLD value here while rotating to avoid missed runs.
CRON_SECRET_PREVIOUS=

# ---- Careers-inbox inbound email webhook (optional) -------------------------
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=

# ---- Optional integrations (all features stay dark when unset) --------------
# LinkedIn organisation-level connect:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://atsiq.yavar.ai/api/public/linkedin/callback
LINKEDIN_SCOPES=
# State-signing secret REQUIRED whenever LinkedIn or a meeting provider is set:
#   openssl rand -hex 32
LINKEDIN_STATE_SECRET=
OAUTH_STATE_SECRET=

# Meeting providers (one-click Connect on the Integrations page):
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# Google sign-in button:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Social scoring (optional; raises GitHub API rate limits):
GITHUB_TOKEN=

# Extra approved job-board API hosts for integrations (comma-separated):
INTEGRATION_ALLOWED_HOSTS=

# =============================================================================
# NOT NEEDED — do not set these on the self-hosted deployment:
#   OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY        (BYO per org in-app;
#     the deployment must never carry a platform-level AI key)
# =============================================================================

# --- Logging (structured JSON lines; debug | info | warn | error) ---
LOG_LEVEL=info
