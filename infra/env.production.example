# =============================================================================
# ATSIQ — production environment template (GCP Cloud Run)
# =============================================================================
# HOW TO USE
#   1. Copy this file, fill in the values, and keep it OUT of git.
#   2. Recommended: put each value in Google Secret Manager and let Cloud Run
#      mount them (names + commands in infra/DEPLOYMENT-HANDOFF.md §2), or set
#      them as plain env vars on the service — both work.
#   3. Only DATABASE_URL and SESSION_SECRET are strictly required to boot.
#      SMTP_URL is required for sign-up/invitation/reset emails to be delivered.
#      Everything else unlocks optional features.
#   4. NEVER commit a filled-in .env to the repository.
# =============================================================================

# ---- Required: the app will not boot without these --------------------------
# Cloud SQL connection string. Recommended (unix socket via the Cloud SQL
# connector — the service needs --add-cloudsql-instances + Cloud SQL Client role):
#   postgres://atsiq:<password>@/atsiq?host=/cloudsql/PROJECT:REGION:atsiq
DATABASE_URL=

# Session cookie secret. Generate: openssl rand -hex 32
# Must be >= 32 chars. Changing it signs out every user.
SESSION_SECRET=

# ---- Required: credential encryption at rest -------------------------------
# Encrypts organisation AI/integration credentials stored in the database.
# Generate: openssl rand -base64 32
# BACK THIS UP: rotating it (or losing it) invalidates every stored credential.
SECRET_ENCRYPTION_KEY=

# ---- Public origin ----------------------------------------------------------
# Used in emails, capture links and OAuth redirects. Must match the final domain.
PUBLIC_SITE_URL=https://atsiq.yavar.ai

# ---- Transactional email (required for sign-up / invites / password reset) --
# Example: smtps://user:pass@smtp.yavar.ai:465
SMTP_URL=
# Display address, e.g. ATSIQ <noreply@yavar.ai>
EMAIL_FROM=

# ---- CV vault: S3-compatible object storage ---------------------------------
# Recommended: GCS bucket with HMAC keys (endpoint https://storage.googleapis.com)
# or any MinIO/S3. Without these the app falls back to local disk (fine for dev,
# NOT acceptable for production — files would not survive instance replacement).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Networking / security --------------------------------------------------
# Number of trusted reverse-proxy hops in front of the app (Cloudflare -> LB ->
# Cloud Run counts as the hops that set X-Forwarded-For). 1 is correct for the
# planned topology. The service must not be reachable except through the proxy.
TRUSTED_PROXY_COUNT=1
# One rate limit across every instance (counters in Postgres, migration 0066).
# Leave unset only for a single-instance deployment.
RATE_LIMIT_STORE=postgres

# Sandboxed document parser (docs/guardrails.md P2-1). When set, every uploaded
# or mailed document is parsed by that service (no network egress), never in
# this process; if it is unreachable the document yields no text.
# PARSER_URL=https://atsiq-parser-xxxx.a.run.app
# PARSER_TOKEN=            # same value as the parser's PARSER_TOKEN
# (PARSE_LIMIT_MS and PORT are set on the parser service itself, not here.)

# ---- Scheduled jobs (careers-inbox scoring, candidate re-scoring) -----------
# Bearer token expected by /api/public/inbox-sync and /api/public/sync-candidates.
# Generate: openssl rand -hex 32 — Cloud Scheduler sends it as Authorization header.
CRON_SECRET=
# Optional: set the OLD value here while rotating to avoid missed runs.
CRON_SECRET_PREVIOUS=

# ---- Careers-inbox inbound email webhook (optional) -------------------------
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=

# ---- Phone screening (docs/voice-screening-agent.md; optional) --------------
# The PBX extension the voice worker dials out from. Unset = phone screening is
# unavailable. SIP_SERVER requires SIP_USER and SIP_PASSWORD (the app refuses to
# boot otherwise). Values are trimmed — CRLF line endings in an env file left a
# "\r" in each value and the PBX silently dropped every request built from them.
SIP_SERVER=
SIP_PORT=5060
SIP_USER=
SIP_PASSWORD=
# Optional overrides when the PBX uses a distinct auth identity or domain:
SIP_AUTH_USER=
SIP_DOMAIN=
# Outbound caller-id name shown to candidates (max 40 chars):
SIP_CALLER_NAME=
# Only when calls have one-way audio behind NAT (the worker's public IP):
SIP_PUBLIC_IP=
# Calls the voice worker holds at once (1–20; keep within the PBX channel limit):
VOICE_MAX_CONCURRENT=2
# Opt-in voice-worker debugging only: append call-audio timing lines (never audio
# or words) to this file. Leave unset in normal operation.
# VOICE_DEBUG_FILE=/tmp/voice-debug.jsonl

# ---- Agent runtime (optional) ------------------------------------------------
# How many agent runs one scheduler tick drives at the same time (1–20,
# default 6). AGENT_INLINE_KICK=0 turns off the instant run start after a
# person acts, leaving only the agent-tick scheduler to drive runs.
AGENT_CONCURRENCY=6
# AGENT_INLINE_KICK=1

# ---- Browser capture extension (optional) ------------------------------------
# Chrome extension ids (comma-separated) allowed to call the capture and
# distribution endpoints; sent as allowed chrome-extension:// CORS origins.
# Generate: chrome://extensions → your unpacked extension's id
CAPTURE_EXTENSION_IDS=

# ---- Google for Jobs indexing (optional) -------------------------------------
# A service account (JSON key, raw or base64) that owns the PUBLIC_SITE_URL
# property in Search Console; jobs are pushed to Google's Indexing API. Unset =
# roles are still listed through structured data on their apply page.
# Quota is shared by every organisation on the deployment.
GOOGLE_INDEXING_CREDENTIALS=
# Indexing-API calls per Pacific day (1–100000, default 180):
GOOGLE_INDEXING_DAILY_LIMIT=180

# ---- Optional integrations (all features stay dark when unset) --------------
# LinkedIn organisation-level connect:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://atsiq.yavar.ai/api/public/linkedin/callback
LINKEDIN_SCOPES=
# State-signing secret REQUIRED whenever LinkedIn or a meeting provider is set:
#   openssl rand -hex 32
LINKEDIN_STATE_SECRET=
OAUTH_STATE_SECRET=

# Meeting providers (one-click Connect on the Integrations page):
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# Google sign-in button:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Social scoring (optional; raises GitHub API rate limits):
GITHUB_TOKEN=

# Extra approved job-board API hosts for integrations (comma-separated):
INTEGRATION_ALLOWED_HOSTS=

# =============================================================================
# NOT NEEDED — do not set these on the self-hosted deployment:
#   OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY        (BYO per org in-app;
#     the deployment must never carry a platform-level AI key)
# =============================================================================

# --- Logging (structured JSON lines; debug | info | warn | error) ---
LOG_LEVEL=info

# --- Observability (README → Observability; infra/monitoring/) ---
# Enables the token-protected /metrics OpenMetrics endpoint (unset = 404):
METRICS_TOKEN=
# Signed webhook for platform SLO burn-rate alerts (HMAC-SHA256 key):
PLATFORM_ALERT_WEBHOOK_URL=
PLATFORM_ALERT_WEBHOOK_SECRET=
# GCP project id: log lines carry logging.googleapis.com/trace for grouping:
GOOGLE_CLOUD_PROJECT=
