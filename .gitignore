# .env is tracked INTENTIONALLY (Lovable's build reads it) and must contain
# only public values (Supabase URL + publishable key). Real secrets —
# service-role key, LinkedIn/GitHub credentials — go in .env.local,
# which is gitignored via *.local and loaded by Vite automatically.
# .env.local

# Local dev object-storage fallback (src/server/storage.ts)
.local-storage/

# Security audit reports — never commit while repo is public
SECURITY_AUDIT_REPORT*.md

# Voice POC: holds a live SIP password and a Google service-account key — never commit (public repo).
ai_interviewer/
